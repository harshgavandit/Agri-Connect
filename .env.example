# Copy to .env for local development. Supply real values privately.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE
SESSION_SECRET=replace-with-a-long-random-session-secret
PUBLIC_APP_URL=http://localhost:5000
APP_ORIGINS=http://localhost:5000

# Generate a separate 32-byte base64 key for each encryption purpose.
APP_ENCRYPTION_KEY=
SELLER_VERIFICATION_ENCRYPTION_KEY=
SELLER_DOCUMENT_ENCRYPTION_KEY=
SELLER_DOCUMENT_STORAGE_PATH=.data/seller-verification

# Keep demonstration deployments isolated from real payments.
PAYMENTS_MODE=mock
PAYMENTS_ENABLED_PROVIDERS=
PAYMENT_SUPPORTED_CURRENCIES=GBP,INR
PAYMENT_DEFAULT_CURRENCY=GBP
PAYMENT_RETURN_BASE_URL=http://localhost:5000
PAYMENT_UI_PREVIEW_ENABLED=false
ENABLE_API_RATE_LIMIT=true

# Optional integrations. Leave unconfigured until needed.
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GEOCODING_API_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
ORG_ADMIN_BOOTSTRAP_EMAILS=
STUDENT_PORTAL_ENABLED=false
E2E_SUPPORT_ENABLED=false
OPPORTUNITY_MONITOR_ENABLED=false
